// Razorpay payment links — update after Razorpay activates
const LINKS = {
  monthly:  "#",   // ← replace with Razorpay ₹99/month link
  lifetime: "#",   // ← replace with Razorpay ₹999 link
  bundle:   "#",   // ← replace with Razorpay ₹129/month link
};
---

<BaseLayout title={`${t.hero_label} | TheCloseReport`}>
  <div style="max-width: 860px; margin: 0 auto; padding: 40px 20px;">

    <!-- Hero -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div style="color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px;">
        {t.hero_label}
      </div>
      <h1 style="font-size: 36px; font-weight: 800; color: var(--text); letter-spacing: -0.5px; margin: 0 0 12px;">
        {t.hero_title}
      </h1>
      <p style="color: var(--muted); font-size: 16px; margin: 0;">
        {t.hero_sub}
      </p>
    </div>

    <!-- Intro clarity box -->
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px 32px; margin-bottom: 32px;">
    <div style="display: flex; flex-direction: column; gap: 12px;">
    <div style="color: var(--text); font-size: 14px; line-height: 1.6;">
      📊 <strong>Global Markets</strong> — free for everyone, daily.
    </div>
    <div style="color: var(--text); font-size: 14px; line-height: 1.6;">
      🇮🇳 <strong>Top 5 MF NAVs</strong> — free in your daily email.
    </div>
    <div style="color: var(--text); font-size: 14px; line-height: 1.6;">
      🔒 <strong>Premium</strong> — unlocks all 10 MF NAVs, weekly summary & archive.
    </div>
    <div style="color: var(--text); font-size: 14px; line-height: 1.6;">
      📱 <strong>WhatsApp Report</strong> — available as an add-on or bundle.
    </div>
    </div>
    </div>

    <!-- Pricing Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 48px;">

      <!-- Free -->
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; text-align: center;">
        <div style="color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px;">
          {t.free_label}
        </div>
        <div style="font-size: 32px; font-weight: 800; color: var(--text); margin-bottom: 4px;">₹0</div>
        <div style="color: var(--muted); font-size: 12px; margin-bottom: 20px;">{t.free_desc}</div>
        <div style="padding: 10px; background: var(--border); border-radius: 8px; color: var(--muted); font-size: 13px; font-weight: 700;">
          {t.cta_free}
        </div>
      </div>

      <!-- Monthly -->
      <div style="background: var(--surface); border: 2px solid var(--accent); border-radius: 14px; padding: 24px; text-align: center; position: relative;">
        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--accent); color: #0d1b2a; font-size: 10px; font-weight: 800; padding: 3px 12px; border-radius: 20px; white-space: nowrap;">
          {t.popular}
        </div>
        <div style="color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px;">
          {t.monthly_label}
        </div>
        <div style="font-size: 32px; font-weight: 800; color: var(--text); margin-bottom: 4px;">₹99</div>
        <div style="color: var(--muted); font-size: 12px; margin-bottom: 20px;">{t.per_month}</div>
        <a href={LINKS.monthly} style="display: block; padding: 10px; background: var(--accent); color: #0d1b2a; border-radius: 8px; font-size: 13px; font-weight: 800; text-decoration: none;">
          {t.cta_monthly}
        </a>
      </div>

      <!-- Lifetime -->
      <div style="background: var(--surface); border: 2px solid #a78bfa; border-radius: 14px; padding: 24px; text-align: center; position: relative;">
        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #a78bfa; color: #0d1b2a; font-size: 10px; font-weight: 800; padding: 3px 12px; border-radius: 20px; white-space: nowrap;">
          {t.best_value}
        </div>
        <div style="color: #a78bfa; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px;">
          {t.lifetime_label}
        </div>
        <div style="font-size: 32px; font-weight: 800; color: var(--text); margin-bottom: 4px;">₹999</div>
        <div style="color: var(--muted); font-size: 12px; margin-bottom: 20px;">{t.one_time}</div>
        <a href={LINKS.lifetime} style="display: block; padding: 10px; background: #a78bfa; color: #0d1b2a; border-radius: 8px; font-size: 13px; font-weight: 800; text-decoration: none;">
          {t.cta_lifetime}
        </a>
      </div>

      <!-- Bundle -->
      <div style="background: var(--surface); border: 1px solid #22c55e; border-radius: 14px; padding: 24px; text-align: center;">
        <div style="color: #22c55e; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px;">
          {t.bundle_label}
        </div>
        <div style="color: var(--muted); font-size: 10px; margin-bottom: 8px;">{t.bundle_sub}</div>
        <div style="font-size: 32px; font-weight: 800; color: var(--text); margin-bottom: 4px;">₹129</div>
        <div style="color: var(--muted); font-size: 12px; margin-bottom: 20px;">{t.per_month}</div>
        <a href={LINKS.bundle} style="display: block; padding: 10px; background: #22c55e; color: #0d1b2a; border-radius: 8px; font-size: 13px; font-weight: 800; text-decoration: none;">
          {t.cta_bundle}
        </a>
      </div>

    </div>

    <!-- What You Get -->
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 24px; text-align: center;">
        {t.what_you_get}
      </h2>

      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border);">
              <th style="padding: 12px 20px; text-align: left; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;">Feature</th>
              <th style="padding: 12px 16px; text-align: center; color: var(--muted); font-size: 11px; text-transform: uppercase;">{t.free_label}</th>
              <th style="padding: 12px 16px; text-align: center; color: var(--accent); font-size: 11px; text-transform: uppercase;">Premium</th>
              <th style="padding: 12px 16px; text-align: center; color: #22c55e; font-size: 11px; text-transform: uppercase;">{t.bundle_label}</th>
            </tr>
          </thead>
          <tbody>
            {[
              { label: t.f_markets,  free: true,  premium: true,  bundle: true  },
              { label: t.f_email,    free: true,  premium: true,  bundle: true  },
              { label: t.f_mf_top5,  free: true,  premium: true,  bundle: true  },
              { label: t.f_mf_top10, free: false, premium: true,  bundle: true  },
              { label: t.f_weekly,   free: false, premium: true,  bundle: true  },
              { label: t.f_archive,  free: false, premium: true,  bundle: true  },
              { label: t.f_whatsapp, free: false, premium: false, bundle: true  },
            ].map((row, i) => (
              <tr style={`border-bottom: 1px solid var(--border); background: ${i % 2 === 0 ? 'transparent' : 'var(--surface)'}`}>
                <td style="padding: 14px 20px; color: var(--text); font-size: 13px;">{row.label}</td>
                <td style="padding: 14px 16px; text-align: center; font-size: 16px;">{row.free ? '✅' : '❌'}</td>
                <td style="padding: 14px 16px; text-align: center; font-size: 16px;">{row.premium ? '✅' : '❌'}</td>
                <td style="padding: 14px 16px; text-align: center; font-size: 16px;">{row.bundle ? '✅' : '❌'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 24px; text-align: center;">
        {t.faq_title}
      </h2>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {[
          { q: t.faq_1_q, a: t.faq_1_a },
          { q: t.faq_2_q, a: t.faq_2_a },
          { q: t.faq_3_q, a: t.faq_3_a },
          { q: t.faq_4_q, a: t.faq_4_a },
        ].map(faq => (
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px 24px;">
            <div style="color: var(--text); font-size: 14px; font-weight: 700; margin-bottom: 8px;">{faq.q}</div>
            <div style="color: var(--muted); font-size: 13px; line-height: 1.6;">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Note -->
    <div style="text-align: center; color: var(--muted); font-size: 11px; padding-top: 24px; border-top: 1px solid var(--border);">
      {t.note}
    </div>

  </div>
</BaseLayout>